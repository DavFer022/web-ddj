@page "/inventario/proveedores"
@using SistemaDDJ.Web.Modules.Inventario.Features.ActualizarProveedor
@using SistemaDDJ.Web.Modules.Inventario.Features.CambiarEstadoProveedor
@using SistemaDDJ.Web.Modules.Inventario.Features.ListarProveedores
@using SistemaDDJ.Web.Modules.Inventario.Features.Proveedores
@using SistemaDDJ.Web.Modules.Inventario.Features.RegistrarProveedor
@inject ListarProveedores.Handler ListarHandler
@inject RegistrarProveedor.Handler RegistrarHandler
@inject ActualizarProveedor.Handler ActualizarHandler
@inject CambiarEstadoProveedor.Handler CambiarEstadoHandler

<PageTitle>Proveedores | Sistema DD&amp;J</PageTitle>

<MudButton Href="/inventario" Variant="Variant.Text" Color="Color.Primary"
           StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-2">
    Volver a inventario
</MudButton>

<MudText Typo="Typo.h3" Class="font-weight-bold">Proveedores</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Administra contactos y mantén disponibles solo los proveedores activos para nuevas compras.
</MudText>

@if (!string.IsNullOrWhiteSpace(_mensaje))
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mb-3">@_mensaje</MudAlert>
}
@if (_errores.Count > 0)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">
        @foreach (var error in _errores)
        {
            <div>@error</div>
        }
    </MudAlert>
}

<MudGrid>
    <MudItem xs="12" lg="5">
        <MudPaper Class="pa-5" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
                    <MudIcon Icon="@(_form.ProveedorId is null ? Icons.Material.Filled.AddBusiness : Icons.Material.Filled.Edit)" />
                </MudAvatar>
                <MudText Typo="Typo.h6">@(_form.ProveedorId is null ? "Nuevo proveedor" : "Editar proveedor")</MudText>
            </MudStack>

            <MudTextField T="string" @bind-Value="_form.RazonSocial" Label="Razón social"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
            <MudTextField T="string" @bind-Value="_form.IdentificacionFiscal" Label="Identificación fiscal"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3" />
            <MudTextField T="string" @bind-Value="_form.Correo" Label="Correo"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" />

            <MudText Typo="Typo.subtitle2" Class="mb-2">Teléfonos</MudText>
            @for (var i = 0; i < _form.Telefonos.Count; i++)
            {
                var indice = i;
                <MudGrid Class="mb-2" Spacing="2">
                    <MudItem xs="12" sm="4">
                        <MudTextField T="string" @bind-Value="_form.Telefonos[indice].Numero" Label="Número"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="3">
                        <MudTextField T="string" @bind-Value="_form.Telefonos[indice].Etiqueta" Label="Etiqueta"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="8" sm="3" Class="d-flex align-center">
                        <MudCheckBox T="bool" @bind-Value="_form.Telefonos[indice].EsPrincipal"
                                     Label="Principal" Dense="true" Color="Color.Primary" />
                    </MudItem>
                    <MudItem xs="4" sm="2" Class="d-flex align-center justify-end">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       aria-label="Quitar teléfono" OnClick="() => QuitarTelefono(indice)" />
                    </MudItem>
                </MudGrid>
            }

            <MudButton OnClick="AgregarTelefono" Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Phone" Size="Size.Small" Class="mb-4">
                Agregar teléfono
            </MudButton>

            <MudStack Row="true" Spacing="2">
                <MudButton OnClick="GuardarAsync" Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Save">Guardar</MudButton>
                @if (_form.ProveedorId is not null)
                {
                    <MudButton OnClick="LimpiarFormulario" Variant="Variant.Outlined" Color="Color.Default">
                        Cancelar edición
                    </MudButton>
                }
            </MudStack>
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="7">
        <MudPaper Elevation="1">
            <MudTable T="ProveedorDto" Items="_proveedores" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>Proveedor</MudTh>
                    <MudTh>Identificación fiscal</MudTh>
                    <MudTh>Teléfonos</MudTh>
                    <MudTh>Estado</MudTh>
                    <MudTh Style="text-align: right;">Acciones</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="Proveedor">
                        <MudText Typo="Typo.body2"><strong>@context.RazonSocial</strong></MudText>
                        @if (!string.IsNullOrWhiteSpace(context.Correo))
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Correo</MudText>
                        }
                    </MudTd>
                    <MudTd DataLabel="Identificación fiscal">@(context.IdentificacionFiscal ?? "—")</MudTd>
                    <MudTd DataLabel="Teléfonos">
                        @(context.Telefonos.Count == 0
                            ? "—"
                            : string.Join(", ", context.Telefonos.Select(t => t.Numero)))
                    </MudTd>
                    <MudTd DataLabel="Estado">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                 Color="@(context.Activo ? Color.Success : Color.Default)">
                            @(context.Activo ? "Activo" : "Inactivo")
                        </MudChip>
                    </MudTd>
                    <MudTd DataLabel="Acciones" Style="text-align: right;">
                        <MudTooltip Text="Editar">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                           OnClick="() => Editar(context)" />
                        </MudTooltip>
                        <MudTooltip Text="@(context.Activo ? "Desactivar" : "Activar")">
                            <MudIconButton Icon="@(context.Activo ? Icons.Material.Filled.Block : Icons.Material.Filled.CheckCircle)"
                                           Color="@(context.Activo ? Color.Error : Color.Success)" Size="Size.Small"
                                           OnClick="() => CambiarEstadoAsync(context)" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">Aún no hay proveedores registrados.</MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private sealed class FormularioProveedor
    {
        public int? ProveedorId { get; set; }
        public string RazonSocial { get; set; } = string.Empty;
        public string? IdentificacionFiscal { get; set; }
        public string? Correo { get; set; }
        public List<FormularioTelefono> Telefonos { get; set; } = [new()];
    }

    private sealed class FormularioTelefono
    {
        public string Numero { get; set; } = string.Empty;
        public string? Etiqueta { get; set; }
        public bool EsPrincipal { get; set; }
    }

    private FormularioProveedor _form = new();
    private IReadOnlyList<ProveedorDto> _proveedores = [];
    private IReadOnlyList<string> _errores = [];
    private string? _mensaje;

    protected override async Task OnInitializedAsync() => await CargarAsync();

    private async Task CargarAsync() =>
        _proveedores = await ListarHandler.HandleAsync(new ListarProveedores.Consulta(SoloActivos: false));

    private void AgregarTelefono() => _form.Telefonos.Add(new FormularioTelefono());

    private void QuitarTelefono(int indice) => _form.Telefonos.RemoveAt(indice);

    private void Editar(ProveedorDto proveedor)
    {
        _form = new FormularioProveedor
        {
            ProveedorId = proveedor.Id,
            RazonSocial = proveedor.RazonSocial,
            IdentificacionFiscal = proveedor.IdentificacionFiscal,
            Correo = proveedor.Correo,
            Telefonos = proveedor.Telefonos
                .Select(t => new FormularioTelefono { Numero = t.Numero, Etiqueta = t.Etiqueta, EsPrincipal = t.EsPrincipal })
                .ToList()
        };
        if (_form.Telefonos.Count == 0) _form.Telefonos.Add(new FormularioTelefono());
        _errores = [];
        _mensaje = null;
    }

    private async Task GuardarAsync()
    {
        _errores = [];
        _mensaje = null;

        var telefonos = _form.Telefonos
            .Where(t => !string.IsNullOrWhiteSpace(t.Numero))
            .Select(t => new TelefonoProveedorDto(t.Numero, t.Etiqueta, t.EsPrincipal))
            .ToList();

        if (_form.ProveedorId is null)
        {
            var resultado = await RegistrarHandler.HandleAsync(
                new RegistrarProveedor.Command(_form.RazonSocial, _form.IdentificacionFiscal, _form.Correo, telefonos));
            _errores = resultado.Errores;
            if (!resultado.Exitoso) return;
            _mensaje = "Proveedor registrado.";
        }
        else
        {
            var resultado = await ActualizarHandler.HandleAsync(
                new ActualizarProveedor.Command(_form.ProveedorId.Value, _form.RazonSocial,
                    _form.IdentificacionFiscal, _form.Correo, telefonos));
            _errores = resultado.Errores;
            if (!resultado.Exitoso) return;
            _mensaje = "Proveedor actualizado.";
        }

        LimpiarFormulario();
        await CargarAsync();
    }

    private async Task CambiarEstadoAsync(ProveedorDto proveedor)
    {
        _errores = [];
        _mensaje = null;
        var resultado = await CambiarEstadoHandler.HandleAsync(
            new CambiarEstadoProveedor.Command(proveedor.Id, !proveedor.Activo));
        _errores = resultado.Errores;
        if (!resultado.Exitoso) return;
        _mensaje = proveedor.Activo ? "Proveedor desactivado." : "Proveedor activado.";
        await CargarAsync();
    }

    private void LimpiarFormulario()
    {
        _form = new FormularioProveedor();
        _errores = [];
    }
}
