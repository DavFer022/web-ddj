@page "/inventario/ajustes"
@using Microsoft.EntityFrameworkCore
@using SistemaDDJ.Web.Modules.Acceso.PublicApi
@using SistemaDDJ.Web.Modules.Inventario.Data
@using SistemaDDJ.Web.Modules.Inventario.Entities
@using SistemaDDJ.Web.Modules.Inventario.Features.ConsultarStock
@using SistemaDDJ.Web.Modules.Inventario.Features.RegistrarAjusteOMerma
@using SistemaDDJ.Web.Modules.Personalizacion.PublicApi
@inject InventarioDbContext Db
@inject IAccesoPublicApi Acceso
@inject IPersonalizacionPublicApi Personalizacion
@inject RegistrarAjusteOMerma.Handler RegistrarAjusteHandler

<PageTitle>Ajustes y mermas | Sistema DD&amp;J</PageTitle>

<MudButton Href="/inventario" Variant="Variant.Text" Color="Color.Primary"
           StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-2">
    Volver a inventario
</MudButton>

<MudText Typo="Typo.h3" Class="font-weight-bold">Ajustes y mermas</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Cuadra el stock físico y deja constancia de las mermas del taller con notas obligatorias.
</MudText>

@if (_usuarioActual is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
        No hay un usuario activo para registrar el movimiento.
    </MudAlert>
}
else
{
    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Class="mb-3"
             Icon="@Icons.Material.Filled.Person">
        Registrado por: @_usuarioActual.NombreVisible
    </MudChip>
}

@if (!string.IsNullOrWhiteSpace(_mensaje))
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mb-3">@_mensaje</MudAlert>
}
@if (_errores.Count > 0)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">
        @foreach (var error in _errores)
        {
            <div>@error</div>
        }
    </MudAlert>
}

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" md="2">
            <MudSelect T="TipoMovimientoInventario" @bind-Value="_tipoMovimiento" Label="Tipo"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="TipoMovimientoInventario" Value="TipoMovimientoInventario.ENTRADA">Entrada</MudSelectItem>
                <MudSelectItem T="TipoMovimientoInventario" Value="TipoMovimientoInventario.SALIDA">Salida</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="2">
            <MudSelect T="MotivoMovimientoInventario" @bind-Value="_motivo"
                       @bind-Value:after="CambiarMotivoAsync" Label="Motivo"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="MotivoMovimientoInventario" Value="MotivoMovimientoInventario.AJUSTE">Ajuste</MudSelectItem>
                <MudSelectItem T="MotivoMovimientoInventario" Value="MotivoMovimientoInventario.MERMA">Merma</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="4">
            <MudTextField T="string" @bind-Value="_notas" Label="Notas (obligatorias)"
                          Placeholder="Explique la causa del ajuste o de la merma"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="2">
            <MudTextField T="string" @bind-Value="_referencia" Label="Referencia"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        @if (_motivo == MotivoMovimientoInventario.MERMA)
        {
            <MudItem xs="12" md="2">
                <MudAutocomplete T="OrdenServicioResumenDto"
                                 @bind-Value="_orden"
                                 Label="Orden (opcional)"
                                 Placeholder="Buscar orden..."
                                 SearchFunc="BuscarOrdenesAsync"
                                 ToStringFunc="@(o => o?.NumeroOrden ?? string.Empty)"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Dense="true"
                                 Clearable="true"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="true"
                                 MaxItems="50" />
            </MudItem>
        }
    </MudGrid>
</MudPaper>

<MudText Typo="Typo.h6" Class="mb-2">Artículos</MudText>
<MudPaper Elevation="1" Class="mb-3">
    <MudTable T="LineaMovimiento" Items="_lineas" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Artículo</MudTh>
            <MudTh Style="text-align: right;">Stock</MudTh>
            <MudTh>Cantidad</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Artículo">
                <MudAutocomplete T="ArticuloOpcion"
                                 @bind-Value="context.Articulo"
                                 Placeholder="Escriba código o nombre del artículo..."
                                 SearchFunc="BuscarArticulosAsync"
                                 ToStringFunc="@(a => a is null ? string.Empty : $"{a.Codigo} — {a.Nombre} ({a.Tipo})")"
                                 Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 Dense="true"
                                 Clearable="true"
                                 ResetValueOnEmptyText="true"
                                 CoerceText="true"
                                 MaxItems="50" />
            </MudTd>
            <MudTd DataLabel="Stock" Style="text-align: right;">@Stock(context.ArticuloId)</MudTd>
            <MudTd DataLabel="Cantidad">
                <MudNumericField T="decimal" @bind-Value="context.Cantidad" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" Min="0" />
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               aria-label="Quitar línea" OnClick="() => QuitarLinea(context)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

<MudStack Row="true" Spacing="2">
    <MudButton OnClick="AgregarLinea" Variant="Variant.Outlined" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add">Agregar línea</MudButton>
    <MudButton OnClick="GuardarAsync" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Save" Disabled="@(_usuarioActual is null)">
        Registrar movimiento
    </MudButton>
</MudStack>

@code {
    private sealed class LineaMovimiento
    {
        public ArticuloOpcion? Articulo { get; set; }
        public int ArticuloId => Articulo?.ArticuloId ?? 0;
        public decimal Cantidad { get; set; }
    }

    private sealed record ArticuloOpcion(
        int ArticuloId,
        string Codigo,
        string Nombre,
        ArticuloTipo Tipo,
        decimal Stock);

    private UsuarioDto? _usuarioActual;
    private IReadOnlyList<OrdenServicioResumenDto> _ordenes = [];
    private List<ArticuloOpcion> _articulos = [];
    private TipoMovimientoInventario _tipoMovimiento = TipoMovimientoInventario.ENTRADA;
    private MotivoMovimientoInventario _motivo = MotivoMovimientoInventario.AJUSTE;
    private string? _notas;
    private string? _referencia;
    private OrdenServicioResumenDto? _orden;
    private List<LineaMovimiento> _lineas = [new()];
    private IReadOnlyList<string> _errores = [];
    private string? _mensaje;

    private IEnumerable<ArticuloOpcion> ArticulosDisponibles =>
        _motivo == MotivoMovimientoInventario.MERMA
            ? _articulos.Where(a => a.Tipo == ArticuloTipo.INSUMO)
            : _articulos;

    protected override async Task OnInitializedAsync()
    {
        _usuarioActual = await Acceso.ObtenerUsuarioActualAsync();
        _ordenes = await Personalizacion.ListarAbiertasAsync();
        await CargarArticulosAsync();
    }

    private Task<IEnumerable<OrdenServicioResumenDto>> BuscarOrdenesAsync(string? texto, CancellationToken _)
    {
        var filtro = texto?.Trim();
        var resultado = string.IsNullOrWhiteSpace(filtro)
            ? _ordenes
            : _ordenes.Where(o =>
                o.NumeroOrden.Contains(filtro, StringComparison.OrdinalIgnoreCase)
                || o.Estado.ToString().Contains(filtro, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult<IEnumerable<OrdenServicioResumenDto>>(resultado);
    }

    private Task<IEnumerable<ArticuloOpcion>> BuscarArticulosAsync(string? texto, CancellationToken _)
    {
        var filtro = texto?.Trim();
        var resultado = string.IsNullOrWhiteSpace(filtro)
            ? ArticulosDisponibles
            : ArticulosDisponibles.Where(a =>
                a.Codigo.Contains(filtro, StringComparison.OrdinalIgnoreCase)
                || a.Nombre.Contains(filtro, StringComparison.OrdinalIgnoreCase));
        return Task.FromResult(resultado);
    }

    private async Task CambiarMotivoAsync()
    {
        if (_motivo == MotivoMovimientoInventario.AJUSTE)
        {
            _orden = null;
            return;
        }

        _tipoMovimiento = TipoMovimientoInventario.SALIDA;
        var permitidos = ArticulosDisponibles.Select(a => a.ArticuloId).ToHashSet();
        foreach (var linea in _lineas.Where(l => l.ArticuloId != 0 && !permitidos.Contains(l.ArticuloId)))
        {
            linea.Articulo = null;
        }

        await Task.CompletedTask;
    }

    private void AgregarLinea() => _lineas.Add(new LineaMovimiento());

    private void QuitarLinea(LineaMovimiento linea)
    {
        _lineas.Remove(linea);
        if (_lineas.Count == 0) _lineas.Add(new LineaMovimiento());
    }

    private string Stock(int articuloId) =>
        _articulos.FirstOrDefault(a => a.ArticuloId == articuloId)?.Stock.ToString("0.###") ?? "—";

    private async Task CargarArticulosAsync()
    {
        var articulos = await Db.Articulos
            .Where(a => a.Activo)
            .OrderBy(a => a.Nombre)
            .ToListAsync();
        var ids = articulos.Select(a => a.Id).ToList();
        var saldos = await SaldosInventario.ObtenerSaldosAsync(Db, ids);
        _articulos = articulos
            .Select(a => new ArticuloOpcion(a.Id, a.Codigo, a.Nombre, a.Tipo, saldos.GetValueOrDefault(a.Id)))
            .ToList();
    }

    private async Task GuardarAsync()
    {
        _errores = [];
        _mensaje = null;
        if (_usuarioActual is null) return;

        var lineas = _lineas
            .Where(l => l.ArticuloId != 0 || l.Cantidad != 0)
            .Select(l => new RegistrarAjusteOMerma.Linea(l.ArticuloId, l.Cantidad))
            .ToList();

        var resultado = await RegistrarAjusteHandler.HandleAsync(
            new RegistrarAjusteOMerma.Command(
                _tipoMovimiento, _motivo, _notas, _usuarioActual.Id,
                _orden?.Id, _referencia, lineas));

        _errores = resultado.Errores;
        if (!resultado.Exitoso) return;

        _mensaje = $"Movimiento de {_motivo} registrado con {lineas.Count} línea(s).";
        _lineas = [new()];
        _notas = null;
        _referencia = null;
        await CargarArticulosAsync();
    }
}
