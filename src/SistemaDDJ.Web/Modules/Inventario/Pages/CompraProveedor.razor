@page "/inventario/compras"
@using Microsoft.EntityFrameworkCore
@using SistemaDDJ.Web.Modules.Acceso.PublicApi
@using SistemaDDJ.Web.Modules.Inventario.Data
@using SistemaDDJ.Web.Modules.Inventario.Entities
@using SistemaDDJ.Web.Modules.Inventario.Features.ListarProveedores
@using SistemaDDJ.Web.Modules.Inventario.Features.Proveedores
@using SistemaDDJ.Web.Modules.Inventario.Features.RegistrarCompraProveedor
@inject InventarioDbContext Db
@inject IAccesoPublicApi Acceso
@inject ListarProveedores.Handler ListarProveedoresHandler
@inject RegistrarCompraProveedor.Handler RegistrarCompraHandler

<PageTitle>Compra a proveedor | Sistema DD&amp;J</PageTitle>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/inventario">Inventario</a></li>
        <li class="breadcrumb-item active" aria-current="page">Compra a proveedor</li>
    </ol>
</nav>

<h1>Compra a proveedor</h1>

@if (_usuarioActual is null)
{
    <div class="alert alert-warning">No hay un usuario activo para registrar la compra.</div>
}
else
{
    <p class="text-muted">Registrada por: <strong>@_usuarioActual.NombreVisible</strong></p>
}

<ul class="text-danger">
    @foreach (var error in _errores)
    {
        <li>@error</li>
    }
</ul>

@if (!string.IsNullOrWhiteSpace(_mensaje))
{
    <div class="alert alert-success">@_mensaje</div>
}

<div class="row g-2 mb-3">
    <div class="col-md-5">
        <label class="form-label">Proveedor</label>
        <select class="form-select" @bind="_proveedorId">
            <option value="0">Seleccione un proveedor activo...</option>
            @foreach (var proveedor in _proveedores)
            {
                <option value="@proveedor.Id">@proveedor.RazonSocial</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Referencia (factura)</label>
        <input class="form-control" @bind="_referencia" />
    </div>
    <div class="col-md-3">
        <label class="form-label">Notas</label>
        <input class="form-control" @bind="_notas" />
    </div>
</div>

<h2 class="h4">Líneas de compra</h2>
<table class="table table-sm align-middle">
    <thead>
        <tr>
            <th>Artículo</th>
            <th style="width: 9rem;">Cantidad</th>
            <th style="width: 9rem;">Costo unitario</th>
            <th style="width: 10rem;">Actualizar costo</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @for (var i = 0; i < _lineas.Count; i++)
        {
            var indice = i;
            <tr>
                <td>
                    <select class="form-select" @bind="_lineas[indice].ArticuloId" @bind:after="() => ActualizarCosto(indice)">
                        <option value="0">Seleccione...</option>
                        @foreach (var articulo in _articulos)
                        {
                            <option value="@articulo.Id">@articulo.Codigo — @articulo.Nombre (@articulo.Tipo)</option>
                        }
                    </select>
                </td>
                <td><input type="number" step="0.001" class="form-control" @bind="_lineas[indice].Cantidad" /></td>
                <td><input type="number" step="0.01" class="form-control" @bind="_lineas[indice].CostoUnitario" /></td>
                <td>
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" @bind="_lineas[indice].ActualizarCostoReferencia" />
                        <label class="form-check-label">Último costo</label>
                    </div>
                </td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => QuitarLinea(indice)">×</button></td>
            </tr>
        }
    </tbody>
</table>

<button type="button" class="btn btn-outline-secondary btn-sm mb-3" @onclick="AgregarLinea">Agregar línea</button>

<div>
    <button class="btn btn-primary" disabled="@(_usuarioActual is null)" @onclick="GuardarAsync">Registrar compra</button>
</div>

@code {
    private sealed class LineaCompra
    {
        public int ArticuloId { get; set; }
        public decimal Cantidad { get; set; }
        public decimal CostoUnitario { get; set; }
        public bool ActualizarCostoReferencia { get; set; }
    }

    private UsuarioDto? _usuarioActual;
    private IReadOnlyList<ProveedorDto> _proveedores = [];
    private List<Articulo> _articulos = [];
    private List<LineaCompra> _lineas = [new()];
    private int _proveedorId;
    private string? _referencia;
    private string? _notas;
    private IReadOnlyList<string> _errores = [];
    private string? _mensaje;

    protected override async Task OnInitializedAsync()
    {
        _usuarioActual = await Acceso.ObtenerUsuarioActualAsync();
        _proveedores = await ListarProveedoresHandler.HandleAsync(new ListarProveedores.Consulta(SoloActivos: true));
        _articulos = await Db.Articulos.Where(a => a.Activo).OrderBy(a => a.Nombre).ToListAsync();
    }

    private void AgregarLinea() => _lineas.Add(new LineaCompra());

    private void QuitarLinea(int indice)
    {
        _lineas.RemoveAt(indice);
        if (_lineas.Count == 0) _lineas.Add(new LineaCompra());
    }

    private void ActualizarCosto(int indice)
    {
        var articulo = _articulos.FirstOrDefault(a => a.Id == _lineas[indice].ArticuloId);
        if (articulo is not null) _lineas[indice].CostoUnitario = articulo.CostoUnitario;
    }

    private async Task GuardarAsync()
    {
        _errores = [];
        _mensaje = null;
        if (_usuarioActual is null) return;

        var lineas = _lineas
            .Where(l => l.ArticuloId != 0 || l.Cantidad != 0 || l.CostoUnitario != 0)
            .Select(l => new RegistrarCompraProveedor.Linea(
                l.ArticuloId, l.Cantidad, l.CostoUnitario, l.ActualizarCostoReferencia))
            .ToList();

        var resultado = await RegistrarCompraHandler.HandleAsync(
            new RegistrarCompraProveedor.Command(
                _proveedorId, _usuarioActual.Id, _referencia, _notas, lineas));

        _errores = resultado.Errores;
        if (!resultado.Exitoso) return;

        _mensaje = $"Compra registrada con {lineas.Count} línea(s).";
        _lineas = [new()];
        _referencia = null;
        _notas = null;
        _articulos = await Db.Articulos.Where(a => a.Activo).OrderBy(a => a.Nombre).ToListAsync();
    }
}
