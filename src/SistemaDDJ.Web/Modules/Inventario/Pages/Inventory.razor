@page "/inventario"
@using Microsoft.EntityFrameworkCore
@using SistemaDDJ.Web.Modules.Inventario.Data
@using SistemaDDJ.Web.Modules.Inventario.Entities
@using SistemaDDJ.Web.Modules.Inventario.Features.ConsultarDashboardInventario
@using SistemaDDJ.Web.Modules.Inventario.Features.RegistrarArticulo
@using SistemaDDJ.Web.Modules.Inventario.Features.RegistrarCategoria
@inject InventarioDbContext Db
@inject RegistrarCategoria.Handler RegistrarCategoriaHandler
@inject RegistrarArticulo.Handler RegistrarArticuloHandler
@inject ConsultarDashboardInventario.Handler DashboardHandler

<PageTitle>Inventario | Sistema DD&amp;J</PageTitle>

<MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Class="mb-4 flex-wrap gap-3">
    <div>
        <MudText Typo="Typo.h3" Class="font-weight-bold">Inventario</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">
            Controla existencias, compras, ventas, consumos y ajustes del taller.
        </MudText>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <MudButton Href="/inventario/proveedores" Variant="Variant.Outlined" Color="Color.Primary"
                   Size="Size.Small" StartIcon="@Icons.Material.Filled.LocalShipping">Proveedores</MudButton>
        <MudButton Href="/inventario/compras" Variant="Variant.Outlined" Color="Color.Primary"
                   Size="Size.Small" StartIcon="@Icons.Material.Filled.AddShoppingCart">Compra</MudButton>
        <MudButton Href="/inventario/ventas" Variant="Variant.Outlined" Color="Color.Primary"
                   Size="Size.Small" StartIcon="@Icons.Material.Filled.PointOfSale">Venta</MudButton>
        <MudButton Href="/inventario/consumos" Variant="Variant.Outlined" Color="Color.Primary"
                   Size="Size.Small" StartIcon="@Icons.Material.Filled.Build">Consumo</MudButton>
        <MudButton Href="/inventario/ajustes" Variant="Variant.Outlined" Color="Color.Primary"
                   Size="Size.Small" StartIcon="@Icons.Material.Filled.Tune">Ajustes</MudButton>
    </div>
</MudStack>

<MudGrid Class="mb-4">
    <MudItem xs="12" md="6">
        <MudPaper Class="metric-card pa-4" Elevation="1">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <div>
                    <MudText Typo="Typo.overline" Class="mud-text-secondary">Productos de venta</MudText>
                    <MudText Typo="Typo.h3" Class="font-weight-bold">@(_dashboard?.Productos.Total ?? 0)</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">artículos registrados</MudText>
                </div>
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled" Size="Size.Large">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory" />
                </MudAvatar>
            </MudStack>
            <MudDivider Class="my-3" />
            <MudStack Row="true" Spacing="2">
                <MudChip T="string" Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small">
                    Agotados: @(_dashboard?.Productos.Agotados ?? 0)
                </MudChip>
                <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small">
                    Bajo stock: @(_dashboard?.Productos.Bajos ?? 0)
                </MudChip>
            </MudStack>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" md="6">
        <MudPaper Class="metric-card metric-success pa-4" Elevation="1">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center">
                <div>
                    <MudText Typo="Typo.overline" Class="mud-text-secondary">Insumos de taller</MudText>
                    <MudText Typo="Typo.h3" Class="font-weight-bold">@(_dashboard?.Insumos.Total ?? 0)</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">artículos registrados</MudText>
                </div>
                <MudAvatar Color="Color.Tertiary" Variant="Variant.Filled" Size="Size.Large">
                    <MudIcon Icon="@Icons.Material.Filled.Brush" />
                </MudAvatar>
            </MudStack>
            <MudDivider Class="my-3" />
            <MudStack Row="true" Spacing="2">
                <MudChip T="string" Color="Color.Error" Variant="Variant.Outlined" Size="Size.Small">
                    Agotados: @(_dashboard?.Insumos.Agotados ?? 0)
                </MudChip>
                <MudChip T="string" Color="Color.Warning" Variant="Variant.Outlined" Size="Size.Small">
                    Bajo stock: @(_dashboard?.Insumos.Bajos ?? 0)
                </MudChip>
            </MudStack>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Outlined="true" Class="pa-4 mb-4" Elevation="0">
    <div class="d-flex flex-wrap align-center gap-3">
        <div class="d-flex gap-1">
            <MudButton Size="Size.Small" Variant="@(_tipoFiltro is null ? Variant.Filled : Variant.Outlined)"
                       Color="@(_tipoFiltro is null ? Color.Primary : Color.Default)"
                       OnClick="() => CambiarTipoAsync(null)">Todos</MudButton>
            <MudButton Size="Size.Small" Variant="@(_tipoFiltro == ArticuloTipo.PRODUCTO ? Variant.Filled : Variant.Outlined)"
                       Color="@(_tipoFiltro == ArticuloTipo.PRODUCTO ? Color.Primary : Color.Default)"
                       OnClick="() => CambiarTipoAsync(ArticuloTipo.PRODUCTO)">Productos</MudButton>
            <MudButton Size="Size.Small" Variant="@(_tipoFiltro == ArticuloTipo.INSUMO ? Variant.Filled : Variant.Outlined)"
                       Color="@(_tipoFiltro == ArticuloTipo.INSUMO ? Color.Primary : Color.Default)"
                       OnClick="() => CambiarTipoAsync(ArticuloTipo.INSUMO)">Insumos</MudButton>
        </div>
        <MudTextField T="string"
                      @bind-Value="_busqueda"
                      Placeholder="Buscar por código o nombre"
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Adornment="Adornment.Start"
                      AdornmentIcon="@Icons.Material.Filled.Search"
                      Class="flex-grow-1"
                      Style="min-width: 220px; max-width: 380px;" />
        <MudButton OnClick="CargarDashboardAsync" Variant="Variant.Filled" Color="Color.Primary"
                   Size="Size.Small" StartIcon="@Icons.Material.Filled.Search">Buscar</MudButton>
        <MudCheckBox T="bool" @bind-Value="_soloAlertas" Label="Solo alertas" Dense="true" Color="Color.Warning" />
        <MudButton OnClick="CargarDashboardAsync" Variant="Variant.Text" Color="Color.Primary"
                   Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh">Actualizar</MudButton>
    </div>
</MudPaper>

<MudPaper Elevation="1" Class="mb-6">
    <MudTable T="ConsultarDashboardInventario.ArticuloStockDto"
              Items="ArticulosDashboard"
              Hover="true"
              Dense="true"
              Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Artículo</MudTh>
            <MudTh>Tipo</MudTh>
            <MudTh>Categoría</MudTh>
            <MudTh Style="text-align: right; white-space: nowrap;">Stock</MudTh>
            <MudTh Style="text-align: right; white-space: nowrap;">Mínimo</MudTh>
            <MudTh>Estado</MudTh>
            <MudTh>Detalle</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Artículo">
                <MudText Typo="Typo.body2"><strong>@context.Codigo</strong> — @context.Nombre</MudText>
                @if (!context.Activo)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">Inactivo</MudChip>
                }
            </MudTd>
            <MudTd DataLabel="Tipo">@context.Tipo</MudTd>
            <MudTd DataLabel="Categoría">@context.Categoria</MudTd>
            <MudTd DataLabel="Stock" Style="text-align: right; white-space: nowrap;">@context.Stock.ToString("0.###") @context.Unidad</MudTd>
            <MudTd DataLabel="Mínimo" Style="text-align: right; white-space: nowrap;">@context.StockMinimo.ToString("0.###")</MudTd>
            <MudTd DataLabel="Estado">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@ColorEstado(context.Estado)">
                    @context.Estado
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Detalle">
                @if (context.Tipo == ArticuloTipo.PRODUCTO)
                {
                    <span>@context.Sku · @(context.PrecioVenta?.ToString("C") ?? "—")</span>
                }
                else
                {
                    <span>@context.DescripcionInsumo</span>
                }
            </MudTd>
        </RowTemplate>
        <NoRecordsContent>
            <MudText Typo="Typo.body2" Class="mud-text-secondary">No hay artículos que coincidan con el filtro.</MudText>
        </NoRecordsContent>
        <LoadingContent>
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
        </LoadingContent>
    </MudTable>
</MudPaper>

<MudText Typo="Typo.h5" Class="font-weight-bold mb-3">Catálogo de inventario</MudText>

<MudGrid>
    <MudItem xs="12" lg="4">
        <MudPaper Class="pa-5" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
                    <MudIcon Icon="@Icons.Material.Filled.Category" />
                </MudAvatar>
                <MudText Typo="Typo.h6">Nueva categoría</MudText>
            </MudStack>
            <MudTextField T="string" @bind-Value="_categoria.Nombre" Label="Nombre" Variant="Variant.Outlined" Class="mb-3" />
            <MudTextField T="string" @bind-Value="_categoria.Descripcion" Label="Descripción" Variant="Variant.Outlined" Class="mb-3" />
            <MudButton OnClick="GuardarCategoriaAsync" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save">Guardar categoría</MudButton>
            @if (_erroresCategoria.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                    @foreach (var error in _erroresCategoria)
                    {
                        <div>@error</div>
                    }
                </MudAlert>
            }
        </MudPaper>
    </MudItem>

    <MudItem xs="12" lg="8">
        <MudPaper Class="pa-5" Elevation="1">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mb-4">
                <MudAvatar Color="Color.Tertiary" Variant="Variant.Filled">
                    <MudIcon Icon="@Icons.Material.Filled.AddBox" />
                </MudAvatar>
                <MudText Typo="Typo.h6">Nuevo artículo</MudText>
            </MudStack>
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudSelect T="ArticuloTipo" @bind-Value="_articulo.Tipo" Label="Tipo" Variant="Variant.Outlined" Dense="true">
                        <MudSelectItem T="ArticuloTipo" Value="ArticuloTipo.PRODUCTO">Producto de venta</MudSelectItem>
                        <MudSelectItem T="ArticuloTipo" Value="ArticuloTipo.INSUMO">Insumo de personalización</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudSelect T="int" @bind-Value="_articulo.CategoriaId" Label="Categoría" Variant="Variant.Outlined" Dense="true">
                        <MudSelectItem T="int" Value="0">Seleccione...</MudSelectItem>
                        @foreach (var categoria in _categorias)
                        {
                            <MudSelectItem T="int" Value="@categoria.Id">@categoria.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" @bind-Value="_articulo.Codigo" Label="Código" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField T="string" @bind-Value="_articulo.Nombre" Label="Nombre" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudSelect T="UnidadMedida" @bind-Value="_articulo.Unidad" Label="Unidad" Variant="Variant.Outlined" Dense="true">
                        @foreach (var unidad in Enum.GetValues<UnidadMedida>())
                        {
                            <MudSelectItem T="UnidadMedida" Value="@unidad">@unidad</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" @bind-Value="_articulo.CostoUnitario" Label="Costo unitario"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField T="decimal" @bind-Value="_articulo.StockMinimo" Label="Stock mínimo"
                                     Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                @if (_articulo.Tipo == ArticuloTipo.PRODUCTO)
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField T="string" @bind-Value="_articulo.Sku" Label="SKU" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal?" @bind-Value="_articulo.PrecioVenta" Label="Precio de venta"
                                         Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                }
                else
                {
                    <MudItem xs="12">
                        <MudTextField T="string" @bind-Value="_articulo.Descripcion" Label="Descripción del insumo"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                }
            </MudGrid>
            <MudButton OnClick="GuardarArticuloAsync" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save" Class="mt-4">Guardar artículo</MudButton>
            @if (_erroresArticulo.Count > 0)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mt-3">
                    @foreach (var error in _erroresArticulo)
                    {
                        <div>@error</div>
                    }
                </MudAlert>
            }
        </MudPaper>
    </MudItem>
</MudGrid>

@code {
    private sealed class FormularioCategoria
    {
        public string Nombre { get; set; } = string.Empty;
        public string? Descripcion { get; set; }
    }

    private sealed class FormularioArticulo
    {
        public ArticuloTipo Tipo { get; set; } = ArticuloTipo.PRODUCTO;
        public int CategoriaId { get; set; }
        public string Codigo { get; set; } = string.Empty;
        public string Nombre { get; set; } = string.Empty;
        public UnidadMedida Unidad { get; set; } = UnidadMedida.UNIDAD;
        public decimal CostoUnitario { get; set; }
        public decimal StockMinimo { get; set; }
        public string? Sku { get; set; }
        public decimal? PrecioVenta { get; set; }
        public string? Descripcion { get; set; }
    }

    private readonly FormularioCategoria _categoria = new();
    private readonly FormularioArticulo _articulo = new();
    private List<CategoriaArticulo> _categorias = [];
    private IReadOnlyList<string> _erroresCategoria = [];
    private IReadOnlyList<string> _erroresArticulo = [];
    private ConsultarDashboardInventario.Resultado? _dashboard;
    private ArticuloTipo? _tipoFiltro;
    private string? _busqueda;
    private bool _soloAlertas;

    private IReadOnlyList<ConsultarDashboardInventario.ArticuloStockDto> ArticulosDashboard =>
        _dashboard?.Articulos ?? [];

    protected override async Task OnInitializedAsync()
    {
        await CargarCategoriasAsync();
        await CargarDashboardAsync();
    }

    private async Task CargarDashboardAsync() =>
        _dashboard = await DashboardHandler.HandleAsync(
            new ConsultarDashboardInventario.Consulta(_tipoFiltro, _busqueda, _soloAlertas));

    private async Task CambiarTipoAsync(ArticuloTipo? tipo)
    {
        _tipoFiltro = tipo;
        await CargarDashboardAsync();
    }

    private static Color ColorEstado(EstadoStock estado) => estado switch
    {
        EstadoStock.AGOTADO => Color.Error,
        EstadoStock.BAJO => Color.Warning,
        _ => Color.Success
    };

    private async Task CargarCategoriasAsync() =>
        _categorias = await Db.CategoriasArticulo.Where(c => c.Activo).OrderBy(c => c.Nombre).ToListAsync();

    private async Task GuardarCategoriaAsync()
    {
        var resultado = await RegistrarCategoriaHandler.HandleAsync(
            new RegistrarCategoria.Command(_categoria.Nombre, _categoria.Descripcion));
        _erroresCategoria = resultado.Errores;
        if (resultado.Exitoso)
        {
            _categoria.Nombre = string.Empty;
            _categoria.Descripcion = null;
            await CargarCategoriasAsync();
        }
    }

    private async Task GuardarArticuloAsync()
    {
        var comando = new RegistrarArticulo.Command(
            _articulo.Codigo, _articulo.Nombre, _articulo.Unidad, _articulo.CostoUnitario, _articulo.CategoriaId,
            _articulo.Tipo, _articulo.PrecioVenta, _articulo.Sku, _articulo.Descripcion, _articulo.StockMinimo);
        var resultado = await RegistrarArticuloHandler.HandleAsync(comando);
        _erroresArticulo = resultado.Errores;
        if (resultado.Exitoso)
        {
            _articulo.Codigo = string.Empty;
            _articulo.Nombre = string.Empty;
            _articulo.Sku = null;
            _articulo.PrecioVenta = null;
            _articulo.Descripcion = null;
            _articulo.StockMinimo = 0;
            await CargarDashboardAsync();
        }
    }
}
