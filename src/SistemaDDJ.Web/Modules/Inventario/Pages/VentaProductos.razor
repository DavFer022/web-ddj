@page "/inventario/ventas"
@using Microsoft.EntityFrameworkCore
@using SistemaDDJ.Web.Modules.Acceso.PublicApi
@using SistemaDDJ.Web.Modules.Clientes.PublicApi
@using SistemaDDJ.Web.Modules.Inventario.Data
@using SistemaDDJ.Web.Modules.Inventario.Entities
@using SistemaDDJ.Web.Modules.Inventario.Features.ConsultarStock
@using SistemaDDJ.Web.Modules.Inventario.Features.RegistrarVentaProductos
@inject InventarioDbContext Db
@inject IAccesoPublicApi Acceso
@inject IClientesPublicApi Clientes
@inject RegistrarVentaProductos.Handler RegistrarVentaHandler

<PageTitle>Venta de productos | Sistema DD&amp;J</PageTitle>

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/inventario">Inventario</a></li>
        <li class="breadcrumb-item active" aria-current="page">Venta de productos</li>
    </ol>
</nav>

<h1>Venta de productos</h1>

@if (_usuarioActual is null)
{
    <div class="alert alert-warning">No hay un usuario activo para registrar la venta.</div>
}
else
{
    <p class="text-muted">Registrada por: <strong>@_usuarioActual.NombreVisible</strong></p>
}

<ul class="text-danger">
    @foreach (var error in _errores)
    {
        <li>@error</li>
    }
</ul>

@if (!string.IsNullOrWhiteSpace(_mensaje))
{
    <div class="alert alert-success">@_mensaje</div>
}

<div class="row g-2 mb-3">
    <div class="col-md-5">
        <label class="form-label">Cliente (opcional)</label>
        <select class="form-select" @bind="_clienteId">
            <option value="">Sin cliente</option>
            @foreach (var cliente in _clientes)
            {
                <option value="@cliente.Id">@cliente.Nombre @cliente.Apellido</option>
            }
        </select>
    </div>
    <div class="col-md-4">
        <label class="form-label">Referencia</label>
        <input class="form-control" @bind="_referencia" />
    </div>
    <div class="col-md-3 d-flex align-items-end">
        <div class="form-check">
            <input class="form-check-input" type="checkbox" id="esCredito" @bind="_esCredito" />
            <label class="form-check-label" for="esCredito">Venta a crédito</label>
        </div>
    </div>
</div>

<h2 class="h4">Productos</h2>
<table class="table table-sm align-middle">
    <thead>
        <tr>
            <th>Producto</th>
            <th class="text-end">Precio</th>
            <th class="text-end">Stock</th>
            <th style="width: 9rem;">Cantidad</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @for (var i = 0; i < _lineas.Count; i++)
        {
            var indice = i;
            var producto = _productos.FirstOrDefault(p => p.ArticuloId == _lineas[indice].ArticuloId);
            <tr>
                <td>
                    <select class="form-select" @bind="_lineas[indice].ArticuloId">
                        <option value="0">Seleccione...</option>
                        @foreach (var opcion in _productos)
                        {
                            <option value="@opcion.ArticuloId">@opcion.Codigo — @opcion.Nombre (@opcion.Sku)</option>
                        }
                    </select>
                </td>
                <td class="text-end">@(producto?.PrecioVenta.ToString("C") ?? "—")</td>
                <td class="text-end">@(producto?.Stock.ToString("0.###") ?? "—")</td>
                <td><input type="number" step="0.001" class="form-control" @bind="_lineas[indice].Cantidad" /></td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" @onclick="() => QuitarLinea(indice)">×</button></td>
            </tr>
        }
    </tbody>
</table>

<button type="button" class="btn btn-outline-secondary btn-sm mb-3" @onclick="AgregarLinea">Agregar línea</button>

<div>
    <button class="btn btn-primary" disabled="@(_usuarioActual is null)" @onclick="GuardarAsync">Registrar venta</button>
</div>

@code {
    private sealed class LineaVenta
    {
        public int ArticuloId { get; set; }
        public decimal Cantidad { get; set; }
    }

    private sealed record ProductoOpcion(
        int ArticuloId,
        string Codigo,
        string Nombre,
        string Sku,
        decimal PrecioVenta,
        decimal Stock);

    private UsuarioDto? _usuarioActual;
    private IReadOnlyList<ClienteResumenDto> _clientes = [];
    private List<ProductoOpcion> _productos = [];
    private Guid? _clienteId;
    private bool _esCredito;
    private string? _referencia;
    private List<LineaVenta> _lineas = [new()];
    private IReadOnlyList<string> _errores = [];
    private string? _mensaje;

    protected override async Task OnInitializedAsync()
    {
        _usuarioActual = await Acceso.ObtenerUsuarioActualAsync();
        _clientes = await Clientes.ListarActivosAsync();
        await CargarProductosAsync();
    }

    private void AgregarLinea() => _lineas.Add(new LineaVenta());

    private void QuitarLinea(int indice)
    {
        _lineas.RemoveAt(indice);
        if (_lineas.Count == 0) _lineas.Add(new LineaVenta());
    }

    private async Task CargarProductosAsync()
    {
        var articulos = await Db.Articulos
            .Where(a => a.Activo && a.Tipo == ArticuloTipo.PRODUCTO)
            .OrderBy(a => a.Nombre)
            .ToListAsync();
        var ids = articulos.Select(a => a.Id).ToList();
        var productos = await Db.Productos.Where(p => ids.Contains(p.ArticuloId)).ToDictionaryAsync(p => p.ArticuloId);
        var saldos = await SaldosInventario.ObtenerSaldosAsync(Db, ids);

        _productos = articulos
            .Where(a => productos.ContainsKey(a.Id))
            .Select(a => new ProductoOpcion(
                a.Id,
                a.Codigo,
                a.Nombre,
                productos[a.Id].Sku,
                productos[a.Id].PrecioVenta,
                saldos.GetValueOrDefault(a.Id)))
            .ToList();
    }

    private async Task GuardarAsync()
    {
        _errores = [];
        _mensaje = null;
        if (_usuarioActual is null) return;

        var lineas = _lineas
            .Where(l => l.ArticuloId != 0 || l.Cantidad != 0)
            .Select(l => new RegistrarVentaProductos.Linea(l.ArticuloId, l.Cantidad))
            .ToList();

        var resultado = await RegistrarVentaHandler.HandleAsync(
            new RegistrarVentaProductos.Command(
                _usuarioActual.Id,
                _clienteId,
                _esCredito,
                _referencia,
                null,
                lineas));

        _errores = resultado.Errores;
        if (!resultado.Exitoso) return;

        _mensaje = $"Venta registrada con {lineas.Count} línea(s).";
        _lineas = [new()];
        _referencia = null;
        _esCredito = false;
        await CargarProductosAsync();
    }
}
