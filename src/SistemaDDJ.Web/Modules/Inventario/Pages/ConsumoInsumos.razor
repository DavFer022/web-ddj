@page "/inventario/consumos"
@using Microsoft.EntityFrameworkCore
@using SistemaDDJ.Web.Modules.Acceso.PublicApi
@using SistemaDDJ.Web.Modules.Inventario.Data
@using SistemaDDJ.Web.Modules.Inventario.Entities
@using SistemaDDJ.Web.Modules.Inventario.Features.ConsultarStock
@using SistemaDDJ.Web.Modules.Inventario.Features.RegistrarConsumoInsumos
@using SistemaDDJ.Web.Modules.Personalizacion.PublicApi
@inject InventarioDbContext Db
@inject IAccesoPublicApi Acceso
@inject IPersonalizacionPublicApi Personalizacion
@inject RegistrarConsumoInsumos.Handler RegistrarConsumoHandler

<PageTitle>Consumo de insumos | Sistema DD&amp;J</PageTitle>

<MudButton Href="/inventario" Variant="Variant.Text" Color="Color.Primary"
           StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-2">
    Volver a inventario
</MudButton>

<MudText Typo="Typo.h3" Class="font-weight-bold">Consumo de insumos</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
    Descuenta del taller exactamente los insumos utilizados en cada orden de servicio.
</MudText>

@if (_usuarioActual is null)
{
    <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
        No hay un usuario activo para registrar el consumo.
    </MudAlert>
}
else
{
    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" Class="mb-3"
             Icon="@Icons.Material.Filled.Person">
        Registrado por: @_usuarioActual.NombreVisible
    </MudChip>
}

@if (!string.IsNullOrWhiteSpace(_mensaje))
{
    <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Dense="true" Class="mb-3">@_mensaje</MudAlert>
}
@if (_errores.Count > 0)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mb-3">
        @foreach (var error in _errores)
        {
            <div>@error</div>
        }
    </MudAlert>
}

<MudPaper Class="pa-4 mb-4" Elevation="1">
    <MudGrid>
        <MudItem xs="12" md="6">
            <MudSelect T="Guid?" @bind-Value="_ordenServicioId" Label="Orden de servicio"
                       Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem T="Guid?" Value="@((Guid?)null)">Seleccione una orden...</MudSelectItem>
                @foreach (var orden in _ordenes)
                {
                    <MudSelectItem T="Guid?" Value="@((Guid?)orden.Id)">
                        @orden.NumeroOrden — @orden.Estado — vence @orden.VenceEn.LocalDateTime.ToString("d")
                    </MudSelectItem>
                }
            </MudSelect>
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTextField T="string" @bind-Value="_referencia" Label="Referencia"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
        <MudItem xs="12" md="3">
            <MudTextField T="string" @bind-Value="_notas" Label="Notas"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
        </MudItem>
    </MudGrid>
</MudPaper>

<MudText Typo="Typo.h6" Class="mb-2">Insumos consumidos</MudText>
<MudPaper Elevation="1" Class="mb-3">
    <MudTable T="LineaConsumo" Items="_lineas" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>Insumo</MudTh>
            <MudTh Style="text-align: right;">Stock</MudTh>
            <MudTh>Cantidad</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Insumo">
                <MudSelect T="int" @bind-Value="context.ArticuloId" Variant="Variant.Outlined"
                           Margin="Margin.Dense" Dense="true">
                    <MudSelectItem T="int" Value="0">Seleccione...</MudSelectItem>
                    @foreach (var opcion in _insumos)
                    {
                        <MudSelectItem T="int" Value="@opcion.ArticuloId">
                            @opcion.Codigo — @opcion.Nombre
                        </MudSelectItem>
                    }
                </MudSelect>
            </MudTd>
            <MudTd DataLabel="Stock" Style="text-align: right;">@Stock(context.ArticuloId)</MudTd>
            <MudTd DataLabel="Cantidad">
                <MudNumericField T="decimal" @bind-Value="context.Cantidad" Variant="Variant.Outlined"
                                 Margin="Margin.Dense" Min="0" />
            </MudTd>
            <MudTd>
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               aria-label="Quitar línea" OnClick="() => QuitarLinea(context)" />
            </MudTd>
        </RowTemplate>
    </MudTable>
</MudPaper>

<MudStack Row="true" Spacing="2">
    <MudButton OnClick="AgregarLinea" Variant="Variant.Outlined" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add">Agregar línea</MudButton>
    <MudButton OnClick="GuardarAsync" Variant="Variant.Filled" Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Save" Disabled="@(_usuarioActual is null)">
        Registrar consumo
    </MudButton>
</MudStack>

@code {
    private sealed class LineaConsumo
    {
        public int ArticuloId { get; set; }
        public decimal Cantidad { get; set; }
    }

    private sealed record InsumoOpcion(int ArticuloId, string Codigo, string Nombre, decimal Stock);

    private UsuarioDto? _usuarioActual;
    private IReadOnlyList<OrdenServicioResumenDto> _ordenes = [];
    private List<InsumoOpcion> _insumos = [];
    private Guid? _ordenServicioId;
    private string? _referencia;
    private string? _notas;
    private List<LineaConsumo> _lineas = [new()];
    private IReadOnlyList<string> _errores = [];
    private string? _mensaje;

    protected override async Task OnInitializedAsync()
    {
        _usuarioActual = await Acceso.ObtenerUsuarioActualAsync();
        _ordenes = await Personalizacion.ListarAbiertasAsync();
        await CargarInsumosAsync();
    }

    private void AgregarLinea() => _lineas.Add(new LineaConsumo());

    private void QuitarLinea(LineaConsumo linea)
    {
        _lineas.Remove(linea);
        if (_lineas.Count == 0) _lineas.Add(new LineaConsumo());
    }

    private string Stock(int articuloId) =>
        _insumos.FirstOrDefault(i => i.ArticuloId == articuloId)?.Stock.ToString("0.###") ?? "—";

    private async Task CargarInsumosAsync()
    {
        var articulos = await Db.Articulos
            .Where(a => a.Activo && a.Tipo == ArticuloTipo.INSUMO)
            .OrderBy(a => a.Nombre)
            .ToListAsync();
        var ids = articulos.Select(a => a.Id).ToList();
        var saldos = await SaldosInventario.ObtenerSaldosAsync(Db, ids);
        _insumos = articulos
            .Select(a => new InsumoOpcion(a.Id, a.Codigo, a.Nombre, saldos.GetValueOrDefault(a.Id)))
            .ToList();
    }

    private async Task GuardarAsync()
    {
        _errores = [];
        _mensaje = null;
        if (_usuarioActual is null) return;

        var lineas = _lineas
            .Where(l => l.ArticuloId != 0 || l.Cantidad != 0)
            .Select(l => new RegistrarConsumoInsumos.Linea(l.ArticuloId, l.Cantidad))
            .ToList();

        var resultado = await RegistrarConsumoHandler.HandleAsync(
            new RegistrarConsumoInsumos.Command(
                _ordenServicioId ?? Guid.Empty, _usuarioActual.Id, _referencia, _notas, lineas));

        _errores = resultado.Errores;
        if (!resultado.Exitoso) return;

        _mensaje = $"Consumo registrado con {lineas.Count} línea(s).";
        _lineas = [new()];
        _referencia = null;
        _notas = null;
        await CargarInsumosAsync();
    }
}
