@page "/not-found"
@layout MainLayout

<PageTitle>No encontrado | Sistema DD&amp;J</PageTitle>

<MudPaper Class="pa-8 text-center" Elevation="1">
    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Warning" />
    <MudText Typo="Typo.h4" Class="mt-3">Página no encontrada</MudText>
    <MudText Typo="Typo.body1" Class="mud-text-secondary mb-4">
        La dirección que buscas no existe o fue movida.
    </MudText>
    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Home">
        Volver al inicio
    </MudButton>
</MudPaper>
