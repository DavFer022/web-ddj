<MudPaper Class="pa-8 text-center" Elevation="1">
    <MudIcon Icon="@Icono" Size="Size.Large" Color="@Color" />
    <MudText Typo="Typo.h4" Class="mt-3">@Titulo</MudText>
    <MudText Typo="Typo.body1" Class="mud-text-secondary mt-2 mb-5">@Descripcion</MudText>
    <MudButton Href="/inventario"
               Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Inventory">
        Ir a inventario
    </MudButton>
</MudPaper>

@code {
    [Parameter, EditorRequired] public string Titulo { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Descripcion { get; set; } = string.Empty;
    [Parameter] public string Icono { get; set; } = Icons.Material.Filled.Construction;
    [Parameter] public Color Color { get; set; } = Color.Primary;
}
